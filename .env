# ========================================
# BASE DE DATOS (Render PostgreSQL)
# ========================================
# La URL de PostgreSQL la proporciona Render automáticamente
# No la pongas en .env local, se inyecta automáticamente en producción
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# ========================================
# SERVIDOR
# ========================================
PORT=8001
HOST=0.0.0.0

# ========================================
# ENTORNO
# ========================================
ENVIRONMENT=development  # development | production
DEBUG=true

# ========================================
# OTRAS CONFIGURACIONES
# ========================================
# Tiempo de espera para scraping (segundos)
SCRAPING_TIMEOUT=180

# Máximo de propiedades a mostrar
MAX_PROPERTIES=10

# Intentos de reconexión a DB
DB_RETRY_ATTEMPTS=3